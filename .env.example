# Database Configuration (Authoritative Source of Truth)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/credit_shop_db?schema=public"

# Redis Configuration (Queues, Distributed Locks, Rate Limiting)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# API & Security
PORT=4000
NODE_ENV="development"
JWT_SECRET="super_secret_credit_shop_jwt_key_2026_change_in_production"
JWT_EXPIRATION="7d"
CUSTOMER_JWT_SECRET="super_secret_customer_portal_jwt_key_2026_change_in_production"
CUSTOMER_JWT_EXPIRATION="30d"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# Payment Gateway (Razorpay/Mock)
PAYMENT_GATEWAY_KEY_ID="rzp_test_mock_key"
PAYMENT_GATEWAY_KEY_SECRET="mock_secret_key"
PAYMENT_GATEWAY_WEBHOOK_SECRET="mock_webhook_secret"
