{
  "name": "credit-shop-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Modern Credit-First Shop Management & Business Intelligence Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "db:generate": "npm run db:generate --workspace=@credit-shop/database",
    "db:push": "npm run db:push --workspace=@credit-shop/database",
    "db:seed": "npm run db:seed --workspace=@credit-shop/database",
    "dev:api": "npm run start:dev --workspace=@credit-shop/api",
    "dev:web": "npm run dev --workspace=@credit-shop/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.4.5"
  }
}
